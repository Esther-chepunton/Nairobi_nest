# Copy to .env for local development. Never commit .env.
SECRET_KEY=dev-secret-key-change-in-production-min-32-chars
JWT_SECRET_KEY=dev-secret-key-change-in-production-min-32-chars
JWT_EXPIRES_DAYS=7
# Local: SQLite file. Production: Neon Postgres connection string.
DATABASE_URL=sqlite:///users.db
WORKER_SECRET=dev-worker-secret
CORS_ORIGINS=http://localhost:5173

# --- M-Pesa Daraja sandbox (https://developer.safaricom.co.ke -> My Apps) ---
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
# Safaricom must be able to reach this. Locally, payments still confirm via the
# status endpoint (STK query), so a localhost value is fine for development.
MPESA_CALLBACK_URL=http://localhost:10000/api/mpesa-callback

# --- Optional ---
OPENWEATHER_API_KEY=
YOUTUBE_API_KEY=
# Overpass mirror if the default server is slow or unreachable from your network
# OVERPASS_URL=https://maps.mail.ru/osm/tools/overpass/api/interpreter

# Live per-request OSM/Wikipedia fetching (off = search served from the database)
LIVE_DISCOVERY_ENABLED=0
LIVE_DISCOVERY_TIMEOUT_SECONDS=8

SEARCH_RESUME_HOURS=48
ANON_COOKIE_NAME=kijiji_aid
# development (default): Lax + COOKIE_SECURE=0 — works on http://localhost
# production: set FLASK_ENV=production (gives SameSite=None + Secure)
COOKIE_SAMESITE=Lax
COOKIE_SECURE=0
SEARCH_CACHE_TTL_SECONDS=900
PLACE_CACHE_MAX_AGE_DAYS=7
